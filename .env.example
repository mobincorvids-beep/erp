PORT=4000
MONGO_URI=mongodb://localhost:27017/pos_erp
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1h
# Access tokens are short-lived on purpose — a refresh token (30 days,
# hashed at rest, single-use/rotating) covers the rest of a session. See
# src/services/refreshTokenService.js.
# Comma-separated list of allowed browser origins for CORS — the deployed
# client's URL(s) in production. Defaults to the local Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# --- Scale-out settings (all optional — every one of these has a safe,
# working fallback for a single-instance/local deployment; see
# src/config/redis.js, src/queue/queue.js, src/config/db.js) ---

# Unset = each API instance rate-limits and caches purely in its own
# memory (correct for exactly one instance) and background jobs
# (webhook delivery, document-expiry sweeps, FBR retry) run inline in
# whichever process triggers them instead of on a durable queue.
# Set it once you run more than one API replica.
# REDIS_URL=redis://localhost:6379

# Set to "true" once REDIS_URL is configured and a `npm run worker`
# process is actually running, to make sale.completed webhook delivery
# non-blocking (queued) instead of awaited inline during checkout.
# WEBHOOK_ASYNC=true

# WORKER_CONCURRENCY=10
# MONGO_MAX_POOL_SIZE=100
# MONGO_MIN_POOL_SIZE=0
# Point read-heavy, staleness-tolerant traffic at replica-set secondaries,
# keeping the primary's write capacity free for checkout/accounting:
# MONGO_READ_PREFERENCE=secondaryPreferred

LOG_LEVEL=info
